# 数据库：宿主机访问用 localhost；compose 内的服务会用 db 主机名覆盖
DATABASE_URL=postgresql+psycopg://butler:change-me@localhost:5432/butler
POSTGRES_USER=butler
# 必须设置（compose 不再提供默认密码）
POSTGRES_PASSWORD=change-me
POSTGRES_DB=butler

# Console 本地测试路由（api 服务）：1 = 开启，默认关闭
ENABLE_CONSOLE=0

# LLM 网关（OpenAI 兼容端点）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
# Agent Plan 凭据（可选）：aliases.yaml 中 provider 为 openai_compat_agent 的档位使用；
# 火山方舟 Agent Plan（智体套餐）OpenAI 兼容端点
LLM_AGENT_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
LLM_AGENT_API_KEY=
# 每用户每日 LLM 调用上限（按用户时区当日计）；<=0 不限制
LLM_DAILY_LIMIT=200

# 飞书应用凭据（长连接模式，feishu 服务用）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书 open_id 白名单（逗号分隔）；留空 = 不限制
ALLOWED_OPEN_IDS=

# 默认时区（新用户首次回复时会告知，可由用户通过 set_timezone 修改）
DEFAULT_TIMEZONE=Asia/Shanghai

# 其他
WORKER_POLL_INTERVAL=1
# trigger 领取租约超时（秒），超时后回收重试
TRIGGER_LEASE_SECONDS=300
LOG_LEVEL=INFO

# 阶段 2：主动消息
# 计划块开始前多少分钟提醒
BLOCK_LEAD_MINUTES=10
# 计划块结束后多少分钟检查是否完成
BLOCK_GRACE_MINUTES=15
# 停机补偿：late_send（窗口内补发并标注迟到）| drop
REMINDER_LATE_POLICY=late_send
# 迟到补发窗口（小时）
REMINDER_LATE_WINDOW_HOURS=24
# 主动消息总开关：1 时非 commitment 一律丢弃
NUDGE_KILL_SWITCH=0
# 物化器运行间隔（秒）
MATERIALIZE_INTERVAL_SECONDS=300

# 阶段 3a：嵌入与记忆写入
# 宿主机脚本直连 127.0.0.1:11434；compose 内服务由 compose 覆盖为 http://ollama:11434
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024
# 最近一条入站消息静默多久后触发抽取（分钟）
MEMORY_IDLE_MINUTES=10
# 未处理入站消息达到多少条立即触发抽取
MEMORY_BATCH_MAX_EVENTS=40
# 开放事实向量近邻阈值（cosine）与返回条数
MEMORY_NEIGHBOR_THRESHOLD=0.75
MEMORY_NEIGHBOR_TOPK=5
