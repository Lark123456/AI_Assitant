# 数据库：宿主机访问用 localhost；compose 内的服务会用 db 主机名覆盖
DATABASE_URL=postgresql+psycopg://butler:butler@localhost:5432/butler
POSTGRES_USER=butler
POSTGRES_PASSWORD=butler
POSTGRES_DB=butler

# LLM 网关（OpenAI 兼容端点）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
# 每用户每日 LLM 调用上限（按用户时区当日计）；<=0 不限制
LLM_DAILY_LIMIT=200

# 飞书应用凭据（长连接模式，feishu 服务用）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书 open_id 白名单（逗号分隔）；留空 = 不限制
ALLOWED_OPEN_IDS=

# 默认时区（新用户首次回复时会告知，可由用户通过 set_timezone 修改）
DEFAULT_TIMEZONE=Asia/Shanghai

# 其他
WORKER_POLL_INTERVAL=1
# trigger 领取租约超时（秒），超时后回收重试
TRIGGER_LEASE_SECONDS=300
LOG_LEVEL=INFO
